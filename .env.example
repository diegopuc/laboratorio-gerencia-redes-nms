# Configurações do Laboratório de Gerência de Redes (LibreNMS + Docker)

# Porta TCP local na qual a interface web do LibreNMS sera publicada (127.0.0.1:LIBRENMS_PORT)
LIBRENMS_PORT=18080

# Credenciais administrativas padrão do LibreNMS
LIBRENMS_ADMIN_USER=admin
LIBRENMS_ADMIN_PASSWORD=GerenciaLab@2026!

# Versao minima da API do daemon Docker para compatibilidade
DOCKER_API_VERSION=1.44
